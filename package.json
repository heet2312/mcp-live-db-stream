{
  "name": "mcp-live-db-stream",
  "version": "1.0.0",
  "description": "Production-grade Streamable HTTP MCP server for real-time MongoDB and SQL Server change streaming",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "smoke": "node scripts/smoke.mjs",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.19.2",
    "mongodb": "^6.8.0",
    "mssql": "^11.0.1",
    "zod": "^3.23.8",
    "winston": "^3.13.0",
    "uuid": "^10.0.0",
    "prom-client": "^15.1.3",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.3.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@types/mssql": "^9.1.5",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "eslint": "^9.7.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0"
  }
}
