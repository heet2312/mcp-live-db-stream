# Server
PORT=3000
LOG_LEVEL=info
NODE_ENV=development

# Session management
SESSION_TTL_MS=3600000
CLEANUP_INTERVAL_MS=60000
MAX_WATCHERS_PER_SESSION=10

# Change log
CHANGE_LOG_MAX_SIZE=100

# Event store (SSE resumability)
EVENT_MAX_AGE_MS=300000
EVENT_MAX_COUNT=1000

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# SQL Server CDC
MAX_CDC_ROWS=10000
